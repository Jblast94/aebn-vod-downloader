AEBNDL_WEB_PORT=8787
# Host bind for completed media. Default is ./downloads next to compose.
# On a dedicated disk you can use /data/downloads instead.
AEBNDL_DOWNLOAD_DIR=./downloads
# Temporary segments. Keep this off library watch folders.
AEBNDL_SEGMENT_DIR=./work
AEBNDL_DB_PATH=/downloads/aebndl-jobs.db
AEBNDL_MAX_CONCURRENT_JOBS=1
AEBNDL_JOB_RETENTION_HOURS=0
TZ=UTC
